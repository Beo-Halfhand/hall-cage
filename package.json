{
  "name": "sealed-cage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deposit bank (cage) for Sealed Hand tables on Midnight preprod: players deposit tNIGHT once, sit with a declared exposure, the judge settles rounds by moving balances. Ledger 9 port (branch ledger9, 11-09): Midnight.js 5, wallet SDK 2, proof server 9; cage4 kept on its 0.31.1 build (packages/cage-l8).",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "compact compile contracts/sealed-cage.compact contracts/managed/sealed-cage",
    "test": "node --test test/*.test.mjs",
    "test:l8": "node --test test/lock.l8.mjs",
    "compile:all": "npm run compile && npm run compile:dice && npm run compile:cage3",
    "cage": "node scripts/cage.mjs",
    "compile:dice": "compact compile contracts/dice-proof.compact contracts/managed/dice-proof",
    "compile:cage3": "compact compile --skip-zk contracts/legacy/cage3.compact contracts/managed/cage3"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@polkadot/api": "16.5.6",
    "cage-l8": "workspace:*",
    "pino": "10.3.1",
    "rxjs": "7.8.2",
    "ws": "8.21.0"
  },
  "pnpm": {
    "overrides": {
      "@midnightntwrk/ledger-v9": "1.0.0",
      "@midnightntwrk/onchain-runtime-v4": "4.0.0",
      "@midnight-ntwrk/platform-js": "3.0.0",
      "@midnight-ntwrk/onchain-runtime-v3": "3.1.2"
    }
  },
  "devDependencies": {
    "@midnight-ntwrk/zkir-v2": "2.2.0"
  }
}
